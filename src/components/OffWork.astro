---
import { Image } from 'astro:assets';
import { offwork } from '../data/site';
import mountains from '../assets/photo/offwork-mountains.jpg';
// Абстрактные формы для карточек: сфера, гора, кольцо, волна, капля, пилюля
const shapes = ['sphere', 'mountain', 'ring', 'wave', 'drop', 'pill'];
---

<section class="offwork section" id="offwork">
  <!-- Фото секции: сильно размыто и приглушено кремовым слоем, чтобы не спорить с карточками -->
  <div class="bg" aria-hidden="true" data-parallax="0.05">
    <Image src={mountains} alt="" width={1600} format="webp" quality={60} loading="lazy" />
  </div>

  <div class="container">
    <div class="section-head" data-reveal>
      <h2>Вне работы</h2>
      <p>Факты обо мне как о человеке</p>
    </div>
    <ul class="cards">
      {
        offwork.map((o, i) => (
          <li data-reveal style={`--i:${i}`}>
            <span class={`shape shape-${shapes[i % shapes.length]}`} aria-hidden="true" />
            {o.value && <b>{o.value}</b>}
            <span>{o.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .offwork {
    position: relative;
    overflow: hidden;
    background: var(--surface);
    isolation: isolate;
  }
  .bg {
    position: absolute;
    inset: -12%;
    z-index: -1;
  }
  .bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    filter: blur(11px) saturate(0.9);
    transform: scale(1.08);
  }
  .bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(243, 235, 214, 0.78) 0%,
      rgba(243, 235, 214, 0.46) 40%,
      rgba(243, 235, 214, 0.6) 100%
    );
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .cards li {
    position: relative;
    display: grid;
    align-content: end;
    gap: 8px;
    min-height: 210px;
    padding: 116px 24px 24px;
    border-radius: var(--r-card);
    background: rgba(250, 245, 233, 0.86);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    color: var(--ink-2);
    line-height: 1.4;
    overflow: hidden;
    isolation: isolate;
  }
  .cards b {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-3);
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  /* Формы: градиент сайта + внутренняя тень, чтобы читались объёмно */
  .shape {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 72px;
    height: 72px;
    z-index: -1;
    background: var(--grad);
    box-shadow:
      inset -10px -12px 24px rgba(2, 17, 12, 0.28),
      inset 8px 10px 20px rgba(255, 255, 255, 0.35),
      0 18px 30px -16px rgba(2, 17, 12, 0.35);
    transition: transform 0.6s var(--ease);
  }
  .cards li:hover .shape {
    transform: translateY(-6px) rotate(-6deg) scale(1.06);
  }
  .shape-sphere {
    border-radius: 50%;
  }
  .shape-mountain {
    width: 84px;
    height: 72px;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
    box-shadow: none;
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.35), transparent 45%),
      var(--grad);
  }
  .shape-ring {
    border-radius: 50%;
    background: transparent;
    box-shadow: none;
    border: 16px solid transparent;
    background:
      linear-gradient(var(--surface), var(--surface)) padding-box,
      var(--grad) border-box;
    filter: drop-shadow(0 14px 18px rgba(2, 17, 12, 0.22));
  }
  .shape-wave {
    width: 96px;
    height: 44px;
    top: 28px;
    border-radius: 999px;
    transform: rotate(-18deg);
  }
  .cards li:hover .shape-wave {
    transform: rotate(-10deg) translateY(-4px) scale(1.05);
  }
  .shape-drop {
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
  }
  .cards li:hover .shape-drop {
    transform: rotate(-50deg) translateY(-6px) scale(1.06);
  }
  .shape-pill {
    width: 44px;
    height: 88px;
    top: 16px;
    border-radius: 999px;
    transform: rotate(22deg);
  }
  .cards li:hover .shape-pill {
    transform: rotate(30deg) translateY(-6px) scale(1.05);
  }
  @media (max-width: 860px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 480px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
