---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <p class="small">© {year} Ринат Акжигитов</p>
    <nav class="footer-links" aria-label="Контакты">
      <a href={site.telegram} target="_blank" rel="noopener">Telegram</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.setka} target="_blank" rel="noopener">Сетка</a>
      <a href={site.resume} target="_blank" rel="noopener">Резюме, PDF</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: 32px;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-size: var(--fs-0);
  }
  .footer-links a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .footer-links a:hover {
    text-decoration: underline;
  }
</style>
