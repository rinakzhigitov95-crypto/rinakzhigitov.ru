---
import { getCollection } from 'astro:content';
import ProjectTile from './ProjectTile.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const VISIBLE = 5;
const hiddenCount = projects.length - VISIBLE;
---

<section class="projects" id="projects">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2>Выполненные проекты</h2>
      <p>
        Описания некоторых проектов и фич с бизнес-задачей, решением и цифрами. Описания и
        артефакты обезличены. В профессиональном портфолио — более 100 продуктовых фич
        и 50 бизнес-проектов.
      </p>
    </div>

    <div class="tiles" data-tiles>
      {
        projects.map((p, i) => (
          <div class:list={['tile-wrap', { 'is-hidden': i >= VISIBLE }]}>
            <ProjectTile project={p} index={i} featured={i === 0} />
          </div>
        ))
      }
    </div>

    {
      hiddenCount > 0 && (
        <div class="more">
          <button type="button" class="btn btn-more" data-more aria-expanded="false" aria-controls="projects">
            <span data-more-label>Показать ещё {hiddenCount}</span>
            <span class="more-icon" aria-hidden="true" />
          </button>
        </div>
      )
    }
  </div>
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-more]');
  const label = document.querySelector<HTMLElement>('[data-more-label]');
  const hidden = Array.from(document.querySelectorAll<HTMLElement>('.tile-wrap.is-hidden'));
  if (btn && label && hidden.length) {
    const total = hidden.length;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      if (!open) {
        hidden.forEach((el, i) => {
          el.classList.remove('is-hidden');
          const tile = el.firstElementChild as HTMLElement | null;
          if (tile) {
            tile.style.setProperty('--i', String(i % 3));
            requestAnimationFrame(() => tile.classList.add('is-in'));
          }
        });
        label.textContent = 'Свернуть';
      } else {
        hidden.forEach((el) => el.classList.add('is-hidden'));
        label.textContent = `Показать ещё ${total}`;
        document.getElementById('projects')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      btn.setAttribute('aria-expanded', String(!open));
    });
  }
</script>

<style>
  .projects {
    position: relative;
    z-index: 2;
    background: var(--dark);
    color: var(--on-dark);
    border-radius: 40px 40px 0 0;
    margin-top: -40px;
    padding-block: clamp(56px, 7vw, 104px);
  }
  .projects h2 {
    color: var(--on-dark);
  }
  .projects .section-head p {
    color: var(--on-dark-2);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .tile-wrap {
    display: contents;
  }
  .tile-wrap.is-hidden {
    display: none;
  }
  .more {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }
  .btn-more {
    background: transparent;
    color: var(--on-dark);
    border-color: color-mix(in srgb, var(--on-dark) 35%, transparent);
  }
  .btn-more:hover {
    background: var(--on-dark);
    color: var(--ink);
  }
  .more-icon {
    position: relative;
    width: 14px;
    height: 14px;
  }
  .more-icon::before,
  .more-icon::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 12px;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform 0.35s var(--ease);
  }
  .more-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .btn-more[aria-expanded='true'] .more-icon::after {
    transform: translate(-50%, -50%) rotate(0);
  }
  @media (max-width: 1024px) {
    .tiles {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .tiles {
      grid-template-columns: 1fr;
    }
    .projects {
      border-radius: 28px 28px 0 0;
    }
  }
</style>
