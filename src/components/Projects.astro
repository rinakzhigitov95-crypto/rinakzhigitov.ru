---
import { getCollection } from 'astro:content';
import ProjectTile from './ProjectTile.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const top = projects.slice(0, 3);
const rest = projects.slice(3);
---

<section class="projects" id="projects">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2>Выполненные проекты</h2>
      <p>
        Каждый проект — с задачей, решением и цифрами. Описания и артефакты обезличены: в них
        нет названий клиентов и внутренних данных компаний.
      </p>
    </div>

    <div class="tiles">
      {top.map((p, i) => <ProjectTile project={p} index={i} />)}
    </div>

    <ol class="plist" aria-label="Остальные проекты">
      {
        rest.map((p, i) => (
          <li data-reveal style={`--i:${i % 4}`}>
            <a href={`/projects/${p.id}/`}>
              <span class="p-metric">
                <b>{p.data.metric}</b>
                <span>{p.data.metricLabel}</span>
              </span>
              <span class="p-text">
                <span class="p-title">{p.data.title}</span>
                <span class="p-sub">{p.data.subtitle}</span>
              </span>
              <span class="p-company">{p.data.company}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .projects {
    position: relative;
    z-index: 2;
    background: var(--dark);
    color: var(--on-dark);
    border-radius: 40px 40px 0 0;
    margin-top: -40px;
    padding-block: clamp(56px, 7vw, 104px);
  }
  .projects h2 {
    color: var(--on-dark);
  }
  .projects .section-head p {
    color: var(--on-dark-2);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  /* Список остальных проектов */
  .plist {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    border-top: 1px solid color-mix(in srgb, var(--on-dark) 18%, transparent);
  }
  .plist li {
    border-bottom: 1px solid color-mix(in srgb, var(--on-dark) 18%, transparent);
  }
  .plist a {
    display: grid;
    grid-template-columns: 220px 1fr auto;
    gap: 16px 40px;
    align-items: center;
    padding: 22px 0;
    color: var(--on-dark);
    text-decoration: none;
    transition: padding 0.35s var(--ease);
  }
  .plist a:hover {
    padding-left: 12px;
  }
  .p-metric {
    display: grid;
    gap: 2px;
  }
  .p-metric b {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-3);
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
  }
  .p-metric span {
    font-size: var(--fs-0);
    color: var(--on-dark-2);
    max-width: 26ch;
  }
  .p-text {
    display: grid;
    gap: 4px;
  }
  .p-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-2);
    line-height: 1.2;
    letter-spacing: -0.01em;
    transition: color 0.3s var(--ease);
  }
  .plist a:hover .p-title {
    color: var(--gold);
  }
  .p-sub {
    color: var(--on-dark-2);
    max-width: 60ch;
  }
  .p-company {
    color: var(--on-dark-2);
    font-size: var(--fs-0);
    white-space: nowrap;
  }
  @media (max-width: 1024px) {
    .tiles {
      grid-template-columns: repeat(2, 1fr);
    }
    .tiles > :global(.tile:first-child) {
      grid-column: span 2;
    }
  }
  @media (max-width: 760px) {
    .plist a {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .p-company {
      order: -1;
    }
    .p-metric {
      order: 3;
    }
  }
  @media (max-width: 640px) {
    .tiles {
      grid-template-columns: 1fr;
    }
    .tiles > :global(.tile:first-child) {
      grid-column: auto;
    }
    .projects {
      border-radius: 28px 28px 0 0;
    }
  }
</style>
