---
import { site } from '../data/site';
---

<section class="contacts section" id="contacts">
  <div class="container contacts-inner" data-reveal>
    <div>
      <h2>Обсудим задачу?</h2>
      <p class="lead">
        Продуктовая роль, консалтинг по клиентскому опыту или разовая консультация — напишите,
        отвечаю в течение дня.
      </p>
    </div>
    <div class="contact-actions">
      <a class="btn btn-primary" href={site.telegram} target="_blank" rel="noopener">Написать в Telegram</a>
      <a class="btn btn-ghost" href={`mailto:${site.email}`}>{site.email}</a>
      <a class="link" href={site.setka} target="_blank" rel="noopener">Профиль в Сетке</a>
      <a class="link" href={site.resume} target="_blank" rel="noopener">Скачать резюме (PDF)</a>
    </div>
  </div>
</section>

<style>
  .contacts {
    background: var(--dark);
    color: var(--on-dark);
  }
  .contacts h2 {
    color: var(--on-dark);
    margin-bottom: 20px;
  }
  .contacts .lead {
    color: var(--on-dark-2);
    max-width: 32em;
  }
  .contacts-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  .contact-actions {
    display: grid;
    gap: 12px;
    justify-items: start;
  }
  .contacts .btn-primary {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--ink);
  }
  .contacts .btn-primary:hover {
    background: #e6d9a4;
    border-color: #e6d9a4;
  }
  .contacts .btn-ghost {
    color: var(--on-dark);
    border-color: var(--on-dark-2);
  }
  .contacts .btn-ghost:hover {
    background: var(--on-dark);
    color: var(--ink);
  }
  .link {
    color: var(--on-dark-2);
    font-size: var(--fs-0);
    padding: 6px 0;
  }
  .link:hover {
    color: var(--on-dark);
  }
  @media (max-width: 860px) {
    .contacts-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
