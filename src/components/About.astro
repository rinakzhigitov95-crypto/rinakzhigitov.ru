---
import { Image } from 'astro:assets';
import { about, languages } from '../data/site';
import photo from '../assets/photo/about.jpg';
---

<section class="about section container" id="about">
  <div class="about-photo" data-reveal data-parallax="0.06">
    <Image src={photo} alt="Ринат Акжигитов" width={640} densities={[1, 2]} format="webp" quality={80} />
  </div>
  <div class="about-text">
    <h2 data-reveal>Обо мне</h2>
    {about.map((p, i) => <p data-reveal style={`--i:${i + 1}`}>{p}</p>)}
    <ul class="langs" data-reveal style="--i:4" aria-label="Языки">
      {
        languages.map((l) => (
          <li>
            <span>{l.name}</span>
            <span class="small">{l.level}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .about-photo img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--r-tile);
  }
  .about-text {
    display: grid;
    gap: 20px;
  }
  .about-text h2 {
    margin-bottom: 12px;
  }
  .about-text p {
    color: var(--ink-2);
  }
  .langs {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .langs li {
    display: inline-flex;
    gap: 8px;
    align-items: baseline;
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    font-size: var(--fs-0);
  }
  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }
    .about-photo {
      max-width: 360px;
    }
  }
</style>
